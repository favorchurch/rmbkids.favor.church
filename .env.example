# Supabase Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_ANON_KEY=your-supabase-anon-key

# Required: protects /api/admin/overview with Authorization: Bearer <secret>
ADMIN_SECRET=replace-with-a-long-random-secret

# Required: signs per-explorer custody tokens returned by first successful sync.
# If omitted, the server-only SUPABASE_SERVICE_ROLE_KEY is used as a fallback.
SYNC_CUSTODY_SECRET=replace-with-a-different-long-random-secret
